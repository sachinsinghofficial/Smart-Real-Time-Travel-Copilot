HOST=127.0.0.1
PORT=3001
ALLOWED_ORIGIN=http://localhost:3000
NEXT_ORIGIN=http://127.0.0.1:3000
# Only for your local machine. Non-loopback anonymous binding is rejected.
GATEWAY_ALLOW_ANONYMOUS=true
# For authenticated gateway use, turn anonymous mode off and set these:
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Optional: Unix domain socket generated by the C++ engine.
COMPUTE_SOCKET=
# Optional public forecast cache. Use rediss:// for remote TLS connections.
REDIS_URL=
